{
  "title": "Reading Statistics Sync",
  "description": "Pair once to sync reading sessions to Techy-Notes. Works on stock CrossPoint.",
  "token": {
    "file": "token.json",
    "path": "token",
    "persist": true
  },
  "auth": {
    "type": "device_code",
    "request": {
      "url": "https://sync-beta.techy-notes.com/api/device/code",
      "method": "POST"
    },
    "poll": {
      "url": "https://sync-beta.techy-notes.com/api/device/token",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"device_code\":\"{device_code}\"}"
    },
    "display_url": "sync-beta.techy-notes.com/link",
    "qr_hint": "Scan to pair your reader with Techy-Notes",
    "manual_hint": "Enter the XXXX-XXXX code on the website"
  },
  "browse": {
    "format": "json",
    "url": "https://sync-beta.techy-notes.com/api/device/catalog?page={page}&limit={limit}",
    "headers": {
      "Authorization": "Bearer {token}"
    },
    "items": "items",
    "fields": {
      "title": "title",
      "author": "subtitle",
      "description": "description",
      "id": "id"
    },
    "page_size": 8
  },
  "events": {
    "reader.session": {
      "request": {
        "method": "POST",
        "url": "https://sync-beta.techy-notes.com/api/device/sessions",
        "headers": {
          "Authorization": "Bearer {token}",
          "Content-Type": "application/json"
        },
        "body": "{\"v\":\"1\",\"id\":\"{event.id}\",\"document\":\"{event.document}\",\"start_time\":\"{event.start_time}\",\"end_time\":\"{event.end_time}\",\"duration_seconds\":\"{event.duration_seconds}\",\"start_progress_bp\":\"{event.start_progress_bp}\",\"end_progress_bp\":\"{event.end_progress_bp}\"}"
      },
      "connect": true
    }
  }
}
