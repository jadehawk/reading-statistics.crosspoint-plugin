{
  "name": "reading-statistics",
  "title": "Reading Statistics",
  "description": "Reading stats & sync (Dessen App)",
  "author": "Jadehawk",
  "version": "0.1.15",
  "compatibility": {
    "firmware_family": ["crosspoint"],
    "plugin_api_min": 1,
    "requires": ["stats.native.v1", "ui.dashboard.v2"]
  },
  "home_shortcut": {
    "label": "Reading Statistics",
    "target": "dashboard",
    "icon": "stats"
  },
  "files": [
    "manifest.json",
    "device.json",
    "README.md",
    "DETAILS.md",
    "icons/book.pbm",
    "icons/clock.pbm",
    "icons/sessions.pbm",
    "icons/turns.pbm",
    "icons/calendar.pbm",
    "icons/bars.pbm",
    "icons/speed.pbm",
    "app.bin"
  ],
  "id": "reading-statistics",
  "permissions": {
    "filesystem": {
      "app_directory": [
        "read",
        "write",
        "delete",
        "list"
      ],
      "read": [
        "/.crosspoint/reading_sessions.jsonl",
        "/Books/**",
        "/sleep.bmp",
        "/sleep-backup.bmp"
      ],
      "write": [
        "/sleep.bmp",
        "/sleep-backup.bmp"
      ],
      "delete": [
        "/sleep.bmp",
        "/sleep-backup.bmp"
      ]
    },
    "library": true,
    "credentials": {
      "shared": [
        "/.crosspoint/reading-statistics-token.json"
      ]
    },
    "network": {
      "origins": [
        "https://sync.techy-notes.com"
      ],
      "handoff": true
    }
  },
  "optional_permissions": {
    "device_identity": true,
    "history_identity": true
  }
}
