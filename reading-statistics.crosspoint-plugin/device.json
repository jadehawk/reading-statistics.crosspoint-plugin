{
  "title": "Reading Statistics",
  "description": "Local reading habits, daily activity, and page turns",
  "dashboard": {
    "source": "reading-stats.v1",
    "pages": [
      {
        "title": "Your Reading",
        "widgets": [
          {"type": "metric", "label": "Reading Time", "field": "total_seconds"},
          {"type": "metric", "label": "Sessions", "field": "sessions"},
          {"type": "metric", "label": "Page Turns", "field": "qualified_turns"},
          {"type": "metric", "label": "Avg. / Turn", "field": "seconds_per_turn"},
          {"type": "metric", "label": "Active Days", "field": "active_days"},
          {"type": "metric", "label": "7-Day Total", "field": "last_7_seconds"}
        ]
      },
      {
        "title": "Your Week",
        "widgets": [
          {"type": "week_bars", "label": "Latest 7 Days"},
          {"type": "metric", "label": "Last Read Day", "field": "latest_day_seconds"}
        ]
      },
      {
        "title": "Activity Calendar",
        "widgets": [
          {"type": "heatmap_28", "label": "Latest 28 Days"},
          {"type": "metric", "label": "Active Days", "field": "active_days"}
        ]
      },
      {
        "title": "All Books",
        "widgets": [
          {"type": "book_list", "label": "Open Book Library"}
        ]
      },
      {
        "title": "Current Book",
        "widgets": [
          {"type": "metric", "label": "Reading Time", "field": "total_seconds", "scope": "current-book"},
          {"type": "metric", "label": "Sessions", "field": "sessions", "scope": "current-book"},
          {"type": "metric", "label": "Page Turns", "field": "qualified_turns", "scope": "current-book"},
          {"type": "metric", "label": "Active Days", "field": "active_days", "scope": "current-book"}
        ]
      },
      {
        "title": "Import Statistics",
        "widgets": [
          {"type": "legacy_import", "label": "Legacy data preview"}
        ]
      }
    ]
  }
}
