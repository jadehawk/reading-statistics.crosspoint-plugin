{
  "title": "Reading Statistics",
  "description": "Offline reading statistics with optional Techy-Notes server sync",
  "dashboard": {
    "source": "reading-stats.v1",
    "pages": [
      {
        "title": "Overall Statistics",
        "widgets": [
          {
            "type": "reading_snapshot",
            "border": "rounded",
            "corner_radius": 12
          },
          {
            "type": "metric",
            "label": "Sessions",
            "field": "sessions",
            "icon": "sessions",
            "compact": true,
            "border": "rounded",
            "corner_radius": 9
          },
          {
            "type": "metric",
            "label": "Page Turns",
            "field": "qualified_turns",
            "icon": "turns",
            "compact": true,
            "border": "rounded",
            "corner_radius": 9
          },
          {
            "type": "time_of_day",
            "label": "Time of Day",
            "border": "rounded",
            "corner_radius": 9
          },
          {
            "type": "week_bars",
            "label": "Latest 7 Days",
            "border": "rounded",
            "corner_radius": 9
          }
        ]
      },
      {
        "title": "Current Book",
        "widgets": [
          {
            "type": "hero",
            "field": "total_seconds",
            "scope": "current-book",
            "icon": "book",
            "border": "rounded",
            "corner_radius": 12
          },
          {
            "type": "metric",
            "label": "Sessions",
            "field": "sessions",
            "icon": "sessions",
            "border": "rounded",
            "corner_radius": 9,
            "compact": true,
            "scope": "current-book"
          },
          {
            "type": "metric",
            "label": "Page Turns",
            "field": "qualified_turns",
            "icon": "turns",
            "border": "rounded",
            "corner_radius": 9,
            "compact": true,
            "scope": "current-book"
          },
          {
            "type": "metric",
            "label": "Active Days",
            "field": "active_days",
            "icon": "calendar",
            "border": "rounded",
            "corner_radius": 9,
            "compact": true,
            "scope": "current-book"
          },
          {
            "type": "metric",
            "label": "Avg. / Turn",
            "field": "seconds_per_turn",
            "icon": "speed",
            "border": "chamfered",
            "corner_radius": 9,
            "compact": true,
            "scope": "current-book"
          },
          {
            "type": "time_of_day",
            "label": "Time of Day",
            "border": "rounded",
            "corner_radius": 9,
            "scope": "current-book"
          }
        ]
      },
      {
        "title": "Your Week",
        "widgets": [
          {
            "type": "week_bars",
            "label": "Latest 7 Days",
            "border": "rounded",
            "corner_radius": 9
          },
          {
            "type": "time_of_day",
            "label": "Time of Day",
            "period": "week",
            "border": "rounded",
            "corner_radius": 9
          },
          {
            "type": "metric",
            "label": "Last Read Day",
            "field": "latest_day_seconds",
            "icon": "clock",
            "border": "rounded",
            "corner_radius": 9
          }
        ]
      },
      {
        "title": "Reading Calendar",
        "widgets": [
          {
            "type": "month_calendar",
            "border": "rounded",
            "corner_radius": 9
          },
          {
            "type": "month_insights",
            "border": "rounded",
            "corner_radius": 9
          }
        ]
      },
      {
        "title": "All Books",
        "widgets": [
          {
            "type": "book_list",
            "label": "All Books"
          }
        ]
      },
      {
        "title": "Import Statistics",
        "widgets": [
          {
            "type": "legacy_import",
            "label": "Legacy data preview"
          }
        ]
      },
      {
        "title": "Server Sync",
        "widgets": [
          {
            "type": "server_sync",
            "label": "Techy-Notes server pairing"
          }
        ]
      }
    ]
  },
  "token": {
    "file": "/.crosspoint/reading-statistics-token.json",
    "path": "token",
    "persist": true
  },
  "auth": {
    "type": "device_code",
    "request": {
      "url": "https://sync.techy-notes.com/api/device/code",
      "method": "POST"
    },
    "poll": {
      "url": "https://sync.techy-notes.com/api/device/token",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"device_code\":\"{device_code}\"}"
    },
    "display_url": "sync.techy-notes.com/link",
    "qr_hint": "Scan to pair your reader with Techy-Notes",
    "manual_hint": "Enter the XXXX-XXXX code on the website"
  },
  "browse": {
    "format": "json",
    "url": "https://sync.techy-notes.com/api/device/catalog",
    "headers": {
      "Authorization": "Bearer {token}"
    },
    "items": "items",
    "fields": {
      "title": "title",
      "author": "subtitle",
      "description": "description",
      "id": "id"
    },
    "page_size": 8
  },
  "events": {
    "reader.session": {
      "request": {
        "method": "POST",
        "url": "https://sync.techy-notes.com/api/device/sessions",
        "headers": {
          "Authorization": "Bearer {token}",
          "Content-Type": "application/json"
        },
        "body": "{\"v\":\"1\",\"id\":\"{event.id}\",\"document\":\"{event.document}\",\"start_time\":\"{event.start_time}\",\"end_time\":\"{event.end_time}\",\"duration_seconds\":\"{event.duration_seconds}\",\"start_progress_bp\":\"{event.start_progress_bp}\",\"end_progress_bp\":\"{event.end_progress_bp}\",\"book\":\"{event.book}\"}"
      },
      "connect": true
    }
  }
}
