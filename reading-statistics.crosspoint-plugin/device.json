{
  "title": "Reading Statistics",
  "description": "Local reading habits, daily activity, and page turns",
  "dashboard": {
    "source": "reading-stats.v1",
    "pages": [
      {
        "title": "Overall Statistics",
        "widgets": [
          {
            "type": "hero",
            "show_value": false,
            "field": "total_seconds",
            "scope": "current-book",
            "icon": "book",
            "border": "rounded",
            "corner_radius": 12
          },
          {
            "type": "metric",
            "label": "Reading Time",
            "field": "total_seconds",
            "icon": "clock",
            "border": "rounded",
            "corner_radius": 9
          },
          {
            "type": "metric",
            "label": "Sessions",
            "field": "sessions",
            "icon": "sessions",
            "border": "rounded",
            "corner_radius": 9
          },
          {
            "type": "metric",
            "label": "Page Turns",
            "field": "qualified_turns",
            "icon": "turns",
            "border": "rounded",
            "corner_radius": 9
          },
          {
            "type": "metric",
            "label": "Active Days",
            "field": "active_days",
            "icon": "calendar",
            "border": "rounded",
            "corner_radius": 9
          },
          {
            "type": "week_bars",
            "label": "Latest 7 Days"
          }
        ]
      },
      {
        "title": "Current Book",
        "widgets": [
          {
            "type": "hero",
            "field": "total_seconds",
            "scope": "current-book",
            "icon": "book",
            "border": "rounded",
            "corner_radius": 12
          },
          {
            "type": "metric",
            "label": "Sessions",
            "field": "sessions",
            "icon": "sessions",
            "border": "rounded",
            "corner_radius": 9,
            "scope": "current-book"
          },
          {
            "type": "metric",
            "label": "Page Turns",
            "field": "qualified_turns",
            "icon": "turns",
            "border": "rounded",
            "corner_radius": 9,
            "scope": "current-book"
          },
          {
            "type": "metric",
            "label": "Active Days",
            "field": "active_days",
            "icon": "calendar",
            "border": "rounded",
            "corner_radius": 9,
            "scope": "current-book"
          },
          {
            "type": "metric",
            "label": "Avg. / Turn",
            "field": "seconds_per_turn",
            "icon": "speed",
            "border": "chamfered",
            "corner_radius": 9,
            "scope": "current-book"
          }
        ]
      },
      {
        "title": "Your Week",
        "widgets": [
          {
            "type": "week_bars",
            "label": "Latest 7 Days"
          },
          {
            "type": "metric",
            "label": "Last Read Day",
            "field": "latest_day_seconds",
            "icon": "clock",
            "border": "rounded",
            "corner_radius": 9
          }
        ]
      },
      {
        "title": "Activity Calendar",
        "widgets": [
          {
            "type": "heatmap_28",
            "label": "Last 4 Weeks"
          },
          {
            "type": "metric",
            "label": "Active Days",
            "field": "active_days",
            "icon": "calendar",
            "border": "rounded",
            "corner_radius": 9
          }
        ]
      },
      {
        "title": "All Books",
        "widgets": [
          {
            "type": "book_list",
            "label": "All Books"
          }
        ]
      },
      {
        "title": "Import Statistics",
        "widgets": [
          {
            "type": "legacy_import",
            "label": "Legacy data preview"
          }
        ]
      }
    ]
  }
}
